9/orgs","repos_url":"https://api.github.com/users/csdev19/repos","events_url":"https://api.github.com/users/csdev19/events{/privacy}","received_events_url":"https://api.github.com/users/csdev19/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1eb063895218166441f8306d551ad15527dc8c9e","url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/1eb063895218166441f8306d551ad15527dc8c9e","html_url":"https://github.com/niway-dev/kaipu-record/commit/1eb063895218166441f8306d551ad15527dc8c9e"}]},{"sha":"928d5b050bb261d107fd7e991d6179d0dc84f3d8","node_id":"C_kwDOS7iax9oAKDkyOGQ1YjA1MGJiMjYxZDEwN2ZkN2U5OTFkNjE3OWQwZGM4NGYzZDg","commit":{"author":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-10-30T20:26:35Z"},"committer":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-10-30T20:26:35Z"},"message":"fix(desktop): roll the registry back when a write fails\n\nupdate() kept the in-memory change after a failed persist, so a rejected add or remove\nstill showed in the list and the next successful write stored it. Updates now snapshot,\nrestore on failure and run one at a time; setActive goes through the same path.\nThe unreachable 'last' refusal is documented and the test that claimed to cover it renamed.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","tree":{"sha":"c901133b5c555ab9a9d10862ccc50f77152033cc","url":"https://api.github.com/repos/niway-dev/kaipu-record/git/trees/c901133b5c555ab9a9d10862ccc50f77152033cc"},"url":"https://api.github.com/repos/niway-dev/kaipu-record/git/commits/928d5b050bb261d107fd7e991d6179d0dc84f3d8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/928d5b050bb261d107fd7e991d6179d0dc84f3d8","html_url":"https://github.com/niway-dev/kaipu-record/commit/928d5b050bb261d107fd7e991d61