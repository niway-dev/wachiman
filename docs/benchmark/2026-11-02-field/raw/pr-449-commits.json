i.github.com/users/csdev19/followers","following_url":"https://api.github.com/users/csdev19/following{/other_user}","gists_url":"https://api.github.com/users/csdev19/gists{/gist_id}","starred_url":"https://api.github.com/users/csdev19/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/csdev19/subscriptions","organizations_url":"https://api.github.com/users/csdev19/orgs","repos_url":"https://api.github.com/users/csdev19/repos","events_url":"https://api.github.com/users/csdev19/events{/privacy}","received_events_url":"https://api.github.com/users/csdev19/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"csdev19","id":32802631,"node_id":"MDQ6VXNlcjMyODAyNjMx","avatar_url":"https://avatars.githubusercontent.com/u/32802631?v=4","gravatar_id":"","url":"https://api.github.com/users/csdev19","html_url":"https://github.com/csdev19","followers_url":"https://api.github.com/users/csdev19/followers","following_url":"https://api.github.com/users/csdev19/following{/other_user}","gists_url":"https://api.github.com/users/csdev19/gists{/gist_id}","starred_url":"https://api.github.com/users/csdev19/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/csdev19/subscriptions","organizations_url":"https://api.github.com/users/csdev19/orgs","repos_url":"https://api.github.com/users/csdev19/repos","events_url":"https://api.github.com/users/csdev19/events{/privacy}","received_events_url":"https://api.github.com/users/csdev19/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"928d5b050bb261d107fd7e991d6179d0dc84f3d8","url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/928d5b050bb261d107fd7e991d6179d0dc84f3d8","html_url":"https://github.com/niway-dev/kaipu-record/commit/928d5b050bb261d107fd7e991d6179d0dc84f3d8"}]},{"sha":"b69ce68b68a0c0e483e4dca4a86158cf82a628f0","node_id":"C_kwDOS7iax9oAKGI2OWNlNjhiNjhhMGMwZTQ4M2U0ZGNhNGE4NjE1OGNmODJhNjI4ZjA","commit":{"author":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-10-30T20:27:43Z"},"committer":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-10-30T20:27:43Z"},"message":"fix(desktop): a late probe answer no longer rebinds the gate to the old workspace\n\nrequireCaptureWorkspace and listState compared the probed id with the gate's stamp after\nthe await. A switch that committed (or was persisting) meanwhile made the old id look like\nan adoption and pointed the gate back at it. WorkspaceGate.adopt() rebinds only when the\ngate still holds the entry the probe started from and the registry's active entry is the\nadopted id.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","tree":{"sha":"9fe8880fce63e62e6970e1ea50be92c626e51cff","url":"https://api.github.com/repos/niway-dev/kaipu-record/git/trees/9fe8880fce63e62e6970e1ea50be92c626e51cff"},"url":"https://api.github.com/repos/niway-dev/kaipu-record/git/commits/b69ce68b68a0c0e483e4dca4a86158cf82a628f0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/b69ce68b68a0c0e483e4dca4a86158cf82a628f0","html_url":"https://github.com/niway-dev/kaipu-record/commit/b69ce68b68a0c0e483e4dca4a86158cf82a628f0","comments_url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/b69ce68b68a0c0e483e4dca4a86158cf82a628f0/comments","author":{"login":"csdev19","id":32802631,"node_id":"MDQ6VXNlcjMyODAyNjMx","avatar_url":"https://avatars.githubusercontent.com/u/32802631?v=4","gravatar_id":"","url":"https://api.github.com/users/csdev19","html_url":"https://github.com/csdev19","followers_url":"https://api.github.com/users/csdev19/followers","following_url":"https://api.github.com/users/csdev19/following{/other_user}","gists_url":"https://api.github.com/users/csdev19/gists{/gist_id}","starred_url":"https://api.githu