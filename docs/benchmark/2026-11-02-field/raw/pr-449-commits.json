[{"sha":"1eb063895218166441f8306d551ad15527dc8c9e","node_id":"C_kwDOS7iax9oAKDFlYjA2Mzg5NTIxODE2NjQ0MWY4MzA2ZDU1MWFkMTU1MjdkYzhjOWU","commit":{"author":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-10-30T19:33:11Z"},"committer":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-10-30T19:33:11Z"},"message":"feat(desktop): workspaces part 1 — registry, migration, switch and switcher\n\nNIW2-580, part 1 of several workspaces (NIW2-370, ADR 0032).\n\n- Registry in userData/preferences.json (`workspaces` key: entries, activeId,\n  legacyCloudOwnerId, hintDismissedAt). `vaultDirectory` keeps mirroring the\n  active path, so an older version opens the active library.\n- First-launch migration: the current library becomes \"Default workspace\" and\n  gets .kaipu/workspace/identity.json. Additive, idempotent, crash-safe, and a\n  preferences.json that does not parse is never overwritten.\n- Add workspace (adopt or initialize a folder, only Kaipu's own file), Remove\n  from list (nothing on disk changes), and the not-connected state: a missing\n  folder is never recreated and captures are refused, never saved elsewhere.\n- Switch transaction in main: windows flush and close their editors (the\n  editors' own leave guards ask about unsaved work), the workspace gate drains,\n  toasts and retained quiet-capture bytes are dropped, then the generation is\n  bumped. Item-scoped IPC carries a workspace stamp; stale calls are rejected\n  with `stale-workspace`. Switching is refused while recording or exporting.\n- A take, its finalize and its cursor track stay bound to the folder the take\n  started in; a quiet capture and its toast Save stay bound to their workspace.\n- Switcher UI (design \"Kaipu Workspaces v2\", section 1) mounted once in the\n  shell header, visible with one workspace, with the one-time hint; LOCKED and\n  NOT CONNECTED states; \"Recording to <name> · Switch\" on Record; \"Saved to\n  <name>\" in the toast; Settings → Workspaces; window title prefix.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"a71cea56da228dde6d6de017e39103a4d2756f4d","url":"https://api.github.com/repos/niway-dev/kaipu-record/git/trees/a71cea56da228dde6d6de017e39103a4d2756f4d"},"url":"https://api.github.com/repos/niway-dev/kaipu-record/git/commits/1eb063895218166441f8306d551ad15527dc8c9e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/1eb063895218166441f8306d551ad15527dc8c9e","html_url":"https://github.com/niway-dev/kaipu-record/commit/1eb063895218166441f8306d551ad15527dc8c9e","comments_url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/1eb063895218166441f8306d551ad15527dc8c9e/comments","author":{"login":"csdev19","id":32802631,"node_id":"MDQ6VXNlcjMyODAyNjMx","avatar_url":"https://avatars.githubusercontent.com/u/32802631?v=4","gravatar_id":"","url":"https://api.github.com/users/csdev19","html_url":"https://github.com/csdev19","followers_url":"https://api.github.com/users/csdev19/followers","following_url":"https://api.github.com/users/csdev19/following{/other_user}","gists_url":"https://api.github.com/users/csdev19/gists{/gist_id}","starred_url":"https://api.github.com/users/csdev19/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/csdev19/subscriptions","organizations_url":"https://api.github.com/users/csdev19/orgs","repos_url":"https://api.github.com/users/csdev19/repos","events_url":"https://api.github.com/users/csdev19/events{/privacy}","received_events_url":"https://api.github.com/users/csdev19/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"csdev19","id":32802631,"node_id":"MDQ6VXNlcjMyODAyNjMx","avatar_url":"https://avatars.githubusercontent.com/u/32802631?v=4","gravatar_id":"","url":"https://api.github.com/users/csdev19","html_url":"https://github.com/csdev19","followers_url":"https://api.github.com/users/csdev19/followers","following_url":"https://api.github.com/users/csdev19/following{/other_user}","gists_url":"https://api.github.com/users/csdev19/gists{/gist_id}","starred_url":"https://api.github.com/users/csdev19/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/csdev19/subscriptions","organizations_url":"https://api.github.com/users/csdev19/orgs","repos_url":"https://api.github.com/users/csdev19/repos","events_url":"https://api.github.com/users/csdev19/events{/privacy}","received_events_url":"https://api.github.com/users/csdev19/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b577e778c58a835de08bcc6247b2e5f2bcfda8b3","url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/b577e778c58a835de08bcc6247b2e5f2bcfda8b3","html_url":"https://github.com/niway-dev/kaipu-record/commit/b577e778c58a835de08bcc6247b2e5f2bcfda8b3"}]},{"sha":"f2b91d19b46683788a8d30d34a450d2094258fd4","node_id":"C_kwDOS7iax9oAKGYyYjkxZDE5YjQ2NjgzNzg4YThkMzBkMzRhNDUwZDIwOTQyNThmZDQ","commit":{"author":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-10-30T20:25:41Z"},"committer":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-10-30T20:25:41Z"},"message":"fix(desktop): drop pending captures only after the switch is persisted\n\nA failed persistActive aborts the switch and keeps the old workspace active, so the\nretained quiet-capture bytes and toasts must survive it.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","tree":{"sha":"00c99abd70dabdcf54447e4b2b743f1e9e2ceae9","url":"https://api.github.com/repos/niway-dev/kaipu-record/git/trees/00c99abd70dabdcf54447e4b2b743f1e9e2ceae9"},"url":"https://api.github.com/repos/niway-dev/kaipu-record/git/commits/f2b91d19b46683788a8d30d34a450d2094258fd4","comment_count":0,"verification":{"verified":false,"reaso