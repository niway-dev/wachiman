[{"sha":"2bcd0a99fa3aa5ce4be454ed9ef5722e5e2cde5e","node_id":"C_kwDOS7iax9oAKDJiY2QwYTk5ZmEzYWE1Y2U0YmU0NTRlZDllZjU3MjJlNWUyY2RlNWU","commit":{"author":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-11-02T04:03:09Z"},"committer":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-11-02T04:03:09Z"},"message":"feat(settings): per-workspace overrides resolved in main, effective snapshots, capture policy (NIW2-601)\n\nFive keys can be overridden per workspace (ADR 0034): the folder-bound four live in\n.kaipu/workspace/settings.json, uploadMode in userData/workspace-settings.json. A folder\nfile applies only while its sha256 matches one this Mac recorded; a changed or adopted file\nis pending until the user answers. settings:get, settings:update and settings:changed carry\nthe active workspace's effective settings, a switch rebroadcasts them, and a screenshot\ncarries the copy mode it started with into the toast, the kept bytes and the editor.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","tree":{"sha":"5b5cb91c970f162a49d4b0783de86bb3dc0894d0","url":"https://api.github.com/repos/niway-dev/kaipu-record/git/trees/5b5cb91c970f162a49d4b0783de86bb3dc0894d0"},"url":"https://api.github.com/repos/niway-dev/kaipu-record/git/commits/2bcd0a99fa3aa5ce4be454ed9ef5722e5e2cde5e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/2bcd0a99fa3aa5ce4be454ed9ef5722e5e2cde5e","html_url":"https://github.com/niway-dev/kaipu-record/commit/2bcd0a99fa3aa5ce4be454ed9ef5722e5e2cde5e","comments_url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/2bcd0a99fa3aa5ce4be454ed9ef5722e5e2cde5e/comments","author":{"login":"csdev19","id":32802631,"node_id":"MDQ6VXNlcjMyODAyNjMx","avatar_url":"https://avatars.githubusercontent.com/u/32802631?v=4","gravatar_id":"","url":"http