","url":"https://api.github.com/users/csdev19","html_url":"https://github.com/csdev19","followers_url":"https://api.github.com/users/csdev19/followers","following_url":"https://api.github.com/users/csdev19/following{/other_user}","gists_url":"https://api.github.com/users/csdev19/gists{/gist_id}","starred_url":"https://api.github.com/users/csdev19/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/csdev19/subscriptions","organizations_url":"https://api.github.com/users/csdev19/orgs","repos_url":"https://api.github.com/users/csdev19/repos","events_url":"https://api.github.com/users/csdev19/events{/privacy}","received_events_url":"https://api.github.com/users/csdev19/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a0bcd77589d1000cfb0cf5de881980ed06258812","url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/a0bcd77589d1000cfb0cf5de881980ed06258812","html_url":"https://github.com/niway-dev/kaipu-record/commit/a0bcd77589d1000cfb0cf5de881980ed06258812"},{"sha":"02dbb2ec6c14b6b3b21d2b2e1acf3c258019b1b6","url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/02dbb2ec6c14b6b3b21d2b2e1acf3c258019b1b6","html_url":"https://github.com/niway-dev/kaipu-record/commit/02dbb2ec6c14b6b3b21d2b2e1acf3c258019b1b6"}]},{"sha":"1fb4fd6cd71530138d3bf207133477a562608f87","node_id":"C_kwDOS7iax9oAKDFmYjRmZDZjZDcxNTMwMTM4ZDNiZjIwNzEzMzQ3N2E1NjI2MDhmODc","commit":{"author":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-11-02T04:51:23Z"},"committer":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-11-02T04:51:23Z"},"message":"fix(desktop): a slow settings refresh never overwrites a newer write in the cache\n\nrefresh() probed outside the per-workspace queue, so a probe that read the old file\nbefore a write could remember it after the write: the cache got the old sha256, the\nmachine record the new one, and this Mac's own overrides read as pending (CodeRabbit).\nEach remember now bumps a per-workspace generation, and a refresh whose probe started\nbefore the latest remember drops its read. The new test reproduces the race and fails\nwithout the change.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"8b1b3b84f0c86c2ed6585035e6d43a53a313add6","url":"https://api.github.com/repos/niway-dev/kaipu-record/git/trees/8b1b3b84f0c86c2ed6585035e6d43a53a313add6"},"url":"https://api.github.com/repos/niway-dev/kaipu-record/git/commits/1fb4fd6cd71530138d3bf207133477a562608f87","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/1fb4fd6cd71530138d3bf207133477a562608f87","html_url":"https://github.com/niway-dev/kaipu-record/commit/1fb4fd6cd71530138d3bf207133477a562608f87","comments_url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/1fb4fd6cd71530138d3bf207133477a562608f87/comments","author":{"login":"csdev19","id":32802631,"node_id":"MDQ6VXNlcjMyODAyNjMx","avatar_url":"https://avatars.githubusercontent.com/u/32802631?v=4","gravatar_id":"","url":"https://api.github.com/users/csdev19","html_url":"https://github.com/csdev19","followers_url":"https://api.github.com/users/csdev19/followers","following_url":"https://api.github.com/users/csdev19/following{/other_user}","gists_url":"https://api.github.com/users/csdev19/gists{/gist_id}","starred_url":"https://api.github.com/users/csdev19/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/csdev19/subscriptions","organizations_url":"https://api.github.com/users/csdev19/orgs","repos_url":"https://api.github.com/users/csdev19/repos","events_url":"https://api.github.com/users/csdev19/events{/privacy}","received_events_url":"https://api.github.com/users/csdev19/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"csdev19","id":3