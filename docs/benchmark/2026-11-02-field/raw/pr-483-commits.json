cts the new\nfolder's sync provider and probes it with the bounded availability check,\nlike every other path that registers or edits a workspace.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","tree":{"sha":"dd72137d761c962e46c78e722d8def65e3fc4c45","url":"https://api.github.com/repos/niway-dev/kaipu-record/git/trees/dd72137d761c962e46c78e722d8def65e3fc4c45"},"url":"https://api.github.com/repos/niway-dev/kaipu-record/git/commits/0253fd77510fb5e9efb5c084ed30185907c4ba8c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/0253fd77510fb5e9efb5c084ed30185907c4ba8c","html_url":"https://github.com/niway-dev/kaipu-record/commit/0253fd77510fb5e9efb5c084ed30185907c4ba8c","comments_url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/0253fd77510fb5e9efb5c084ed30185907c4ba8c/comments","author":{"login":"csdev19","id":32802631,"node_id":"MDQ6VXNlcjMyODAyNjMx","avatar_url":"https://avatars.githubusercontent.com/u/32802631?v=4","gravatar_id":"","url":"https://api.github.com/users/csdev19","html_url":"https://github.com/csdev19","followers_url":"https://api.github.com/users/csdev19/followers","following_url":"https://api.github.com/users/csdev19/following{/other_user}","gists_url":"https://api.github.com/users/csdev19/gists{/gist_id}","starred_url":"https://api.github.com/users/csdev19/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/csdev19/subscriptions","organizations_url":"https://api.github.com/users/csdev19/orgs","repos_url":"https://api.github.com/users/csdev19/repos","events_url":"https://api.github.com/users/csdev19/events{/privacy}","received_events_url":"https://api.github.com/users/csdev19/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"csdev19","id":32802631,"node_id":"MDQ6VXNlcjMyODAyNjMx","avatar_url":"https://avatars.githubu