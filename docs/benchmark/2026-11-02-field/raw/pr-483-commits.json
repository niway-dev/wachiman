[{"sha":"1c7cea8f9a3a934861d7fc1e168844dad693ea67","node_id":"C_kwDOS7iax9oAKDFjN2NlYThmOWEzYTkzNDg2MWQ3ZmMxZTE2ODg0NGRhZDY5M2VhNjc","commit":{"author":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-11-02T04:59:07Z"},"committer":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-11-02T04:59:07Z"},"message":"feat(api): cloud_asset.workspace_id and PUT /assets/{assetId}/workspace (NIW2-602)\n\nA cloud asset records the desktop workspace it lives in (ADR 0032): a nullable,\nopaque text column with no foreign key. An upload intent takes an optional\nworkspaceId (a re-upload without one keeps the asset's), the catalog responses\ncarry it, and PUT /assets/{assetId}/workspace assigns or clears it, scoped to\nthe owner and idempotent.\n\nThe migration is generated by drizzle-kit on top of the committed-migration\nchain of PR #364 (ADR 0029, still open), as 0003: one ALTER TABLE ... ADD\nCOLUMN, no rewrite of existing rows.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"ed34ddfa40a7d9fa561c012736a3460dbb19fa69","url":"https://api.github.com/repos/niway-dev/kaipu-record/git/trees/ed34ddfa40a7d9fa561c012736a3460dbb19fa69"},"url":"https://api.github.com/repos/niway-dev/kaipu-record/git/commits/1c7cea8f9a3a934861d7fc1e168844dad693ea67","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/1c7cea8f9a3a934861d7fc1e168844dad693ea67","html_url":"https://github.com/niway-dev/kaipu-record/commit/1c7cea8f9a3a934861d7fc1e168844dad693ea67","comments_url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/1c7cea8f9a3a934861d7fc1e168844dad693ea67/comments","author":{"login":"csdev19","id":32802631,"node_id":"MDQ6VXNlcjMyODAyNjMx","avatar_url":"https://avatars.githubusercontent.com/u/32802631?v=4","gravatar_id":"","url":"https://api.github.com/users/csdev19","html_url":"https://github.com/csdev19","followers_url":"https://api.github.com/users/csdev19/followers","following_url":"https://api.github.com/users/csdev19/following{/other_user}","gists_url":"https://api.github.com/users/csdev19/gists{/gist_id}","starred_url":"https://api.github.com/users/csdev19/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/csdev19/subscriptions","organizations_url":"https://api.github.com/users/csdev19/orgs","repos_url":"https://api.github.com/users/csdev19/repos","events_url":"https://api.github.com/users/csdev19/events{/privacy}","received_events_url":"https://api.github.com/users/csdev19/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"csdev19","id":32802631,"node_id":"MDQ6VXNlcjMyODAyNjMx","avatar_url":"https://avatars.githubusercontent.com/u/32802631?v=4","gravatar_id":"","url":"https://api.github.com/users/csdev19","html_url":"https://github.com/csdev19","followers_url":"https://api.github.com/users/csdev19/followers","following_url":"https://api.github.com/users/csdev19/following{/other_user}","gists_url":"https://api.github.com/users/csdev19/gists{/gist_id}","starred_url":"https://api.github.com/users/csdev19/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/csdev19/subscriptions","organizations_url":"https://api.github.com/users/csdev19/orgs","repos_url":"https://api.github.com/users/csdev19/repos","events_url":"https://api.github.com/users/csdev19/events{/privacy}","received_events_url":"https://api.github.com/users/csdev19/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"75698b79783413f3ea1caff4d894d699f12ba5f1","url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/75698b79783413f3ea1caff4d894d699f12ba5f1","html_url":"https://github.com/niway-dev/kaipu-record/commit/75698b79783413f3ea1caff4d894d699f12ba5f1"}]},{"sha":"c36db614a853e23eb888365d02b151dbc0958adf","node_id":"C_kwDOS7iax9oAKGMzNmRiNjE0YTg1M2UyM2ViODg4MzY1ZDAyYjE1MWRiYzA5NThhZGY","commit":{"author":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-11-02T05:29:35Z"},"committer":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-11-02T05:29:35Z"},"message":"feat(desktop): per-workspace cloud catalog and synced-folder safety (NIW2-602, NIW2-577)\n\nCloud (ADR 0032, decisions 3, 4, 23):\n- the catalog maps the server's workspaceId, and the Library composes with a\n  view filtered to the active workspace; the cache keeps every entry, and\n  lastSeenLocalId updates merge into it inside its write chain. This replaces\n  the part-1 stopgap (ownsLegacyCloud).\n- unassigned entries (no workspace, or one not on this Mac) show only under\n  Cloud -> \"Unassigned cloud items\", with \"Assign to workspace...\". Until the\n  first assignment the legacy owner (Default) keeps listing the null ones.\n- a committed move queues PUT /assets/{id}/workspace in a persisted retry\n  queue; it never blocks the move, and a pending assignment overlays the\n  catalog so an offline move never shows the item in its old workspace. A\n  server without the endpoint is tolerated (queued, retried).\n- the upload-intent request type requires workspaceId (desktop upload has not\n  shipped; this is its request).\n\nSynced folders (decision 15):\n- Google Drive, OneDrive and iCloud Drive folders are detected by path after\n  realpath, plus Google Drive's xattr on identity.json; the provider is named\n  on the Cloud page, the switcher and Settings -> Workspaces.\n- scratch files (recording staging, move staging, drag copies) go to\n  userData/workspace-scratch/<id>/, and nothing is hard-linked into or out of\n  a synced workspace: drag copies are real copies, takes are placed by rename,\n  and a move with a synced side copies, verifies sha256 at the final path and\n  then deletes.\n- evicted files are read from SF_DATALESS via /usr/bin/stat -f %f in one\n  batch per listing: no thumbnail URL, the media protocol answers 409, the\n  orphan heal skips them, and they cannot be dragged or moved.\n- the availability probe of a synced workspace is bounded and never lists\n  the provider root.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"26cc700ec5d35338e77e9fdd94f6e23617fe7da2","url":"https://api.github.com/repos/niway-dev/kaipu-record/git/trees/26cc700ec5d35338e77e9fdd94f6e23617fe7da2"},"url":"https://api.github.com/repos/niway-dev/kaipu-record/git/commits/c36db614a853e23eb888365d02b151dbc0958adf","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/c36db614a853e23eb888365d02b151dbc0958adf","html_url":"https://github.com/niway-dev/kaipu-record/commit/c36db614a853e23eb888365d02b151dbc0958adf","comments_url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/c36db614a853e23eb888365d02b151dbc0958adf/comments","author":{"login":"csdev19","id":32802631,"node_id":"MDQ6VXNlcjMyODAyNjMx","avatar_url":"https://avatars.githubusercontent.com/u/32802631?v=4","gravatar_id":"","url":"https://api.github.com/users/csdev19","html_url":"https://github.com/csdev19","followers_url":"https://api.github.com/users/csdev19/followers","following_url":"https://api.github.com/users/csdev19/following{/other_user}","gists_url":"https://api.github.com/users/csdev19/gists{/gist_id}","starred_url":"https://api.github.com/users/csdev19/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/csdev19/subscriptions","organizations_url":"https://api.github.com/users/csdev19/orgs","repos_url":"https://api.github.com/users/csdev19/repos","events_url":"https://api.github.com/users/csdev19/events{/privacy}","received_events_url":"https://api.github.com/users/csdev19/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{