[{"sha":"c59e58fb89d3c5bc3ce2b0e122f8fb93e59c1074","node_id":"C_kwDOS7iax9oAKGM1OWU1OGZiODlkM2M1YmMzY2UyYjBlMTIyZjhmYjkzZTU5YzEwNzQ","commit":{"author":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-10-30T07:32:42Z"},"committer":{"name":"Cristian Sotomayor","email":"cristiansotomayor.dev@gmail.com","date":"2026-10-30T07:32:42Z"},"message":"fix(desktop): a sidecar read error never mints a new assetId (NIW2-568)\n\nLibraryVault.sidecar() returned {} on any read or parse error, so\nensureIdentity() treated the item as legacy, minted a new assetId and the next\nwrite persisted it, silently losing the title, tags, edit links and cloud\nassociation on a momentary EIO/EACCES, a truncated file or an evicted cloud file.\n\nOnly ENOENT now means \"no sidecar\". Any other failure throws\nSidecarUnavailableError (unreadable | corrupt); a corrupt sidecar is copied\naside once per session. describe() lists such an item with metadataIssue set and\na stand-in assetId, and every write path refuses until a later read succeeds.\n\nCo-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>","tree":{"sha":"ed10788b62704ef181c99da346c082f8c8853291","url":"https://api.github.com/repos/niway-dev/kaipu-record/git/trees/ed10788b62704ef181c99da346c082f8c8853291"},"url":"https://api.github.com/repos/niway-dev/kaipu-record/git/commits/c59e58fb89d3c5bc3ce2b0e122f8fb93e59c1074","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/c59e58fb89d3c5bc3ce2b0e122f8fb93e59c1074","html_url":"https://github.com/niway-dev/kaipu-record/commit/c59e58fb89d3c5bc3ce2b0e122f8fb93e59c1074","comments_url":"https://api.github.com/repos/niway-dev/kaipu-record/commits/c59e58fb89d3c5bc3ce2b0e122f8fb93e59c1074/comments","author":{"login":"csdev19","id":32802631,"node_id":"MDQ6VXNlcjMyODAyNjMx","avatar_url":"https://avatars.githubusercontent.com/u/32