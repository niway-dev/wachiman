{
  "name": "wachiman",
  "version": "1.20.1",
  "description": "Advisory pull request reviews by an agent CLI, run in your own GitHub Actions with your own key, or locally on your own Claude subscription",
  "private": false,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niway-dev/wachiman.git"
  },
  "bin": {
    "wachiman": "bin/wachiman.js"
  },
  "files": [
    "bin/wachiman.js",
    "bin/launcher-args.js",
    "src/",
    "skills/",
    "templates/",
    "bunfig.toml",
    "LICENSE",
    "README.md",
    "!**/*.test.ts",
    "!**/fixtures/"
  ],
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "bun": "1.3.4",
    "chalk": "5.6.2"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "bun test",
    "fmt": "bunx bun@1.4.5 fmt --no-script",
    "fmt:check": "bunx bun@1.4.5 fmt --check --no-script",
    "lint": "bun scripts/ratchet.ts lint",
    "lint:raw": "bunx bun@1.4.5-canary.20261121.1 lint --no-script",
    "check": "bun scripts/ratchet.ts check",
    "check:raw": "bunx bun@1.4.5 check --all --no-script",
    "ratchet": "bun scripts/ratchet.ts",
    "ratchet:update": "bun scripts/ratchet.ts --update"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "@types/node": "26.6.6"
  }
}
