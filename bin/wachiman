#!/usr/bin/env bash
# Global entry point for the Wachiman CLI, from any project directory.
#   wachiman local [--commit X | --from X | --base REF] [--history] ...
#   wachiman history [--verdict ID correct|partial|wrong] ...
# Bun never loads the reviewed project's dotenv files or bunfig.toml. The wrapper changes no
# environment variable and adds no flag: the account (--profile, project binding, $WACHIMAN_PROFILE,
# default) and the refusal of an ANTHROPIC_API_KEY are decided inside the command, so this entry
# point and `bun src/cli.ts` behave the same.
set -euo pipefail

if [[ -n "${WACHIMAN_DIR:-}" ]]; then
  dir="$WACHIMAN_DIR"
else
  # Resolve this script through symlinks (no `readlink -f` on macOS), then go up from bin/.
  src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    link="$(readlink "$src")"
    if [[ "$link" == /* ]]; then src="$link"; else src="$(dirname "$src")/$link"; fi
  done
  dir="$(cd "$(dirname "$src")/.." && pwd -P)"
fi

if [[ ! -f "$dir/src/cli.ts" ]]; then
  echo "wachiman: no engine at $dir (set WACHIMAN_DIR to your Wachiman clone)" >&2
  exit 2
fi

exec bun --no-env-file --config="$dir/bunfig.toml" "$dir/src/cli.ts" "$@"
